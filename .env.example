# Environment Configuration for FlashCart
NODE_ENV=development
PORT=3000

# PostgreSQL Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flashcart_db
POSTGRES_USER=flashcart_user
POSTGRES_PASSWORD=flashcart_password

# Connection String
DATABASE_URL=postgres://flashcart_user:flashcart_password@localhost:5432/flashcart_db

# Connection Pool Settings
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000

# Migration Configuration
MIGRATION_TRANSACTION_MODE=wrapped
